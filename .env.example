# Birdly (offentlig side) — miljøvariabler.
# UDFYLDES KUN i Vercel env vars (det offentlige projekt) + lokal .env.local.
# Skriv ALDRIG rigtige nøgler i denne fil eller i repoet.
#
# Her bruges KUN den offentlige anon-nøgle. Via RLS må anon kun INSERTE i
# subscribers (tilmelding) og support_messages (chat). Service-key bor i admin.

NEXT_PUBLIC_SUPABASE_URL=https://uwbwireaaakiyxrtglof.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=   # anon/publishable-nøgle (offentlig, client-side)

# 30-dages launch-fase (gratis adgang uden kort). Sæt til "nu + 30 dage" ved go-live
# (ISO-dato/tid). Tom/passeret -> normal flow (banner/streamer/velkomstboks skjules).
# Build-time embedded -> ændring kræver redeploy. ?launch=<iso> kan preview'es i URL.
NEXT_PUBLIC_LAUNCH_DEADLINE=     # fx 2026-07-15T23:59:00+02:00
